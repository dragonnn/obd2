#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export HOST_UID="$(id -u)"
export HOST_GID="$(id -g)"

action=${1:-shell}
shift || true

case "$action" in
    image|download) ;;
    prepare)
        if [[ ! -x "$project_dir/sdk/.repo/repo/repo" ]]; then
            echo "Packed SDK not found (expected sdk/.repo/repo/repo)." >&2
            echo "Run: ./lyra-build download" >&2
            exit 1
        fi
        ;;
    *)
        if [[ ! -x "$project_dir/sdk/build.sh" ]]; then
            echo "Prepared SDK not found (expected sdk/build.sh)." >&2
            echo "Run: ./lyra-build download && ./lyra-build prepare" >&2
            exit 1
        fi
        ;;
esac

case "$action" in
    image)
        exec docker compose -f "$project_dir/compose.yaml" build
        ;;
    clean)
        exec docker compose -f "$project_dir/compose.yaml" run --rm lyra-sdk \
            bash -lc 'set -euo pipefail
                make -C buildroot O=output/rockchip_rk3506_luckfox clean'
        ;;
    flash)
        flash_tool="$project_dir/sdk/tools/linux/Linux_Upgrade_Tool/Linux_Upgrade_Tool/upgrade_tool"
        firmware="$project_dir/sdk/output/firmware/update.img"

        if [[ ! -x "$flash_tool" ]]; then
            echo "Rockchip upgrade_tool not found: $flash_tool" >&2
            exit 1
        fi
        if [[ ! -f "$firmware" ]]; then
            echo "Firmware image not found: $firmware" >&2
            echo "Run: ./lyra-build build" >&2
            exit 1
        fi

        exec "$flash_tool" uf "$firmware"
        ;;
    download)
        mkdir -p "$project_dir/sdk"
        sdk_url=${LYRA_SDK_URL:-https://drive.google.com/uc?id=15nq-Fac9q6zmisKZgLDZyoifSkL_48rG}
        sdk_archive=${LYRA_SDK_ARCHIVE:-Luckfox_Lyra_SDK_250815.tar.gz}
        exec docker compose -f "$project_dir/compose.yaml" run --rm \
            -e "SDK_URL=$sdk_url" -e "SDK_ARCHIVE=$sdk_archive" lyra-sdk \
            bash -lc 'set -euo pipefail
                mkdir -p /sdk/.downloads
                archive="/sdk/.downloads/$SDK_ARCHIVE"
                gdown --continue "$SDK_URL" --output "$archive"
                tar -tzf "$archive" >/dev/null
                tar -xzf "$archive" -C /sdk
                test -x /sdk/.repo/repo/repo || {
                    echo "Archive extracted, but /sdk/.repo/repo/repo was not found." >&2
                    exit 1
                }
                echo "SDK downloaded and extracted successfully; run ./lyra-build prepare next."'
        ;;
    download-cache)
        cache_url=${LYRA_DL_URL:-https://drive.google.com/uc?id=141mZGnuNIFr3BU5-163Y4OPj_aXF0puN}
        exec docker compose -f "$project_dir/compose.yaml" run --rm \
            -e "CACHE_URL=$cache_url" lyra-sdk \
            bash -lc 'set -euo pipefail
                mkdir -p /sdk/.downloads
                archive=/sdk/.downloads/dl.tar.gz
                gdown --continue "$CACHE_URL" --output "$archive"
                tar -tzf "$archive" >/dev/null
                tar -xzf "$archive" -C /sdk/buildroot
                echo "Buildroot offline download cache installed successfully."'
        ;;
    prepare)
        exec docker compose -f "$project_dir/compose.yaml" run --rm lyra-sdk \
            bash -lc 'set -euo pipefail
                if [[ -x .repo/repo/repo ]]; then .repo/repo sync -l; else echo "Missing .repo/repo/repo" >&2; exit 1; fi
                install -D /project/kernel/arch/arm/boot/dts/rk3506-luckfox-lyra-co6300.dtsi kernel/arch/arm/boot/dts/rk3506-luckfox-lyra-co6300.dtsi
                install -D /project/kernel/arch/arm/boot/dts/rk3506b-luckfox-lyra-zero-w-co6300.dts kernel/arch/arm/boot/dts/rk3506b-luckfox-lyra-zero-w-co6300.dts
                install -D /project/kernel/arch/arm/configs/rk3506-squashfs.config kernel/arch/arm/configs/rk3506-squashfs.config
                install -D /project/buildroot/configs/rockchip_rk3506_luckfox_defconfig buildroot/configs/rockchip_rk3506_luckfox_defconfig
                install -D /project/buildroot/package/fish/Config.in buildroot/package/fish/Config.in
                install -D /project/buildroot/package/fish/fish.mk buildroot/package/fish/fish.mk
                install -D /project/buildroot/package/fish/fish.hash buildroot/package/fish/fish.hash
                grep -q "source \"package/fish/Config.in\"" buildroot/package/Config.in || \
                    sed -i "/source \"package\\/sed\\/Config.in\"/i source \"package/fish/Config.in\"" buildroot/package/Config.in
                install -D /project/device/rockchip/.chips/rk3506/luckfox_lyra_zero-w_buildroot_spinand_defconfig device/rockchip/.chips/rk3506/luckfox_lyra_zero-w_buildroot_spinand_defconfig
                install -D -m 0755 /project/device/rootfs/post-rootfs-cleanup.sh device/rockchip/common/post-hooks/99-clean-generated-files.sh
                install -D /project/buildroot/package/obd2-dashboard/Config.in buildroot/package/obd2-dashboard/Config.in
                install -D /project/buildroot/package/obd2-dashboard/obd2-dashboard.mk buildroot/package/obd2-dashboard/obd2-dashboard.mk
                grep -q "source \"package/obd2-dashboard/Config.in\"" buildroot/package/Config.in || \
                    sed -i "/source \"package\\/sed\\/Config.in\"/i source \"package/obd2-dashboard/Config.in\"" buildroot/package/Config.in
                install -D /project/buildroot/package/fb-reset/Config.in buildroot/package/fb-reset/Config.in
                install -D /project/buildroot/package/fb-reset/fb-reset.mk buildroot/package/fb-reset/fb-reset.mk
                grep -q "source \"package/fb-reset/Config.in\"" buildroot/package/Config.in || \
                    sed -i "/source \"package\\/sed\\/Config.in\"/i source \"package/fb-reset/Config.in\"" buildroot/package/Config.in
                sed -i "s/^RUST_BIN_VERSION = .*/RUST_BIN_VERSION = 1.98.0/" buildroot/package/rust-bin/rust-bin.mk
                sed -i -E "s/sha256  [0-9a-f]+  rust-1\\.74\\.1-x86_64-unknown-linux-gnu\\.tar\\.xz/sha256  ed8ee2df70909c88cbaf87a6cfa3920dac00b537de12a6abe6906641e0f5952f  rust-1.98.0-x86_64-unknown-linux-gnu.tar.xz/" buildroot/package/rust-bin/rust-bin.hash
                sed -i -E "s/sha256  [0-9a-f]+  rust-std-1\\.74\\.1-armv7-unknown-linux-gnueabihf\\.tar\\.xz/sha256  94f2b00c79a288f145855f46b946b108a96d45fc8a4d1c1666ea472d4674e90d  rust-std-1.98.0-armv7-unknown-linux-gnueabihf.tar.xz/" buildroot/package/rust-bin/rust-bin.hash
                for patch_file in /project/patches/*.patch; do
                    echo "Applying ${patch_file##*/}"
                    if patch --dry-run --forward --batch -p0 < "$patch_file" >/dev/null 2>&1; then
                        patch --forward --batch -p0 < "$patch_file"
                    elif patch --dry-run --reverse --batch -p0 < "$patch_file" >/dev/null 2>&1; then
                        echo "Already applied: ${patch_file##*/}"
                    else
                        echo "Failed to apply ${patch_file##*/}" >&2
                        exit 1
                    fi
                done'
        ;;
    sync-sources)
        exec docker compose -f "$project_dir/compose.yaml" run --rm lyra-sdk \
            bash -lc 'set -euo pipefail
                install -D /project/kernel/arch/arm/boot/dts/rk3506-luckfox-lyra-co6300.dtsi kernel/arch/arm/boot/dts/rk3506-luckfox-lyra-co6300.dtsi
                install -D /project/kernel/arch/arm/boot/dts/rk3506b-luckfox-lyra-zero-w-co6300.dts kernel/arch/arm/boot/dts/rk3506b-luckfox-lyra-zero-w-co6300.dts
                install -D /project/kernel/arch/arm/configs/rk3506-squashfs.config kernel/arch/arm/configs/rk3506-squashfs.config
                install -D /project/buildroot/configs/rockchip_rk3506_luckfox_defconfig buildroot/configs/rockchip_rk3506_luckfox_defconfig
                install -D /project/buildroot/package/fish/Config.in buildroot/package/fish/Config.in
                install -D /project/buildroot/package/fish/fish.mk buildroot/package/fish/fish.mk
                install -D /project/buildroot/package/fish/fish.hash buildroot/package/fish/fish.hash
                grep -q "source \"package/fish/Config.in\"" buildroot/package/Config.in || \
                    sed -i "/source \"package\\/sed\\/Config.in\"/i source \"package/fish/Config.in\"" buildroot/package/Config.in
                install -D /project/device/rockchip/.chips/rk3506/luckfox_lyra_zero-w_buildroot_spinand_defconfig device/rockchip/.chips/rk3506/luckfox_lyra_zero-w_buildroot_spinand_defconfig
                install -D -m 0755 /project/device/rootfs/post-rootfs-cleanup.sh device/rockchip/common/post-hooks/99-clean-generated-files.sh
                install -D /project/buildroot/package/obd2-dashboard/Config.in buildroot/package/obd2-dashboard/Config.in
                install -D /project/buildroot/package/obd2-dashboard/obd2-dashboard.mk buildroot/package/obd2-dashboard/obd2-dashboard.mk
                grep -q "source \"package/obd2-dashboard/Config.in\"" buildroot/package/Config.in || \
                    sed -i "/source \"package\\/sed\\/Config.in\"/i source \"package/obd2-dashboard/Config.in\"" buildroot/package/Config.in
                install -D /project/buildroot/package/fb-reset/Config.in buildroot/package/fb-reset/Config.in
                install -D /project/buildroot/package/fb-reset/fb-reset.mk buildroot/package/fb-reset/fb-reset.mk
                grep -q "source \"package/fb-reset/Config.in\"" buildroot/package/Config.in || \
                    sed -i "/source \"package\\/sed\\/Config.in\"/i source \"package/fb-reset/Config.in\"" buildroot/package/Config.in
                sed -i "s/^RUST_BIN_VERSION = .*/RUST_BIN_VERSION = 1.98.0/" buildroot/package/rust-bin/rust-bin.mk
                sed -i -E "s/sha256  [0-9a-f]+  rust-1\\.74\\.1-x86_64-unknown-linux-gnu\\.tar\\.xz/sha256  ed8ee2df70909c88cbaf87a6cfa3920dac00b537de12a6abe6906641e0f5952f  rust-1.98.0-x86_64-unknown-linux-gnu.tar.xz/" buildroot/package/rust-bin/rust-bin.hash
                sed -i -E "s/sha256  [0-9a-f]+  rust-std-1\\.74\\.1-armv7-unknown-linux-gnueabihf\\.tar\\.xz/sha256  94f2b00c79a288f145855f46b946b108a96d45fc8a4d1c1666ea472d4674e90d  rust-std-1.98.0-armv7-unknown-linux-gnueabihf.tar.xz/" buildroot/package/rust-bin/rust-bin.hash
                for patch_file in /project/patches/*.patch; do
                    echo "Applying ${patch_file##*/}"
                    if patch --dry-run --forward --batch -p0 < "$patch_file" >/dev/null 2>&1; then
                        patch --forward --batch -p0 < "$patch_file"
                    elif patch --dry-run --reverse --batch -p0 < "$patch_file" >/dev/null 2>&1; then
                        echo "Already applied: ${patch_file##*/}"
                    else
                        echo "Failed to apply ${patch_file##*/}" >&2
                        exit 1
                    fi
                done'
        ;;
    lunch)
        exec docker compose -f "$project_dir/compose.yaml" run --rm lyra-sdk ./build.sh lunch
        ;;
    build)
        "$project_dir/lyra-build" sync-sources
        exec docker compose -f "$project_dir/compose.yaml" run --rm lyra-sdk ./build.sh "${@}"
        ;;
    rootfs|kernel|uboot|firmware|buildroot-config)
        "$project_dir/lyra-build" sync-sources
        if [[ "$action" == rootfs || "$action" == firmware ]]; then
            docker compose -f "$project_dir/compose.yaml" run --rm lyra-sdk \
                bash -lc 'make -C buildroot O=output/rockchip_rk3506_luckfox obd2-dashboard-dirclean'
        fi
        if [[ "$action" == firmware ]]; then
            docker compose -f "$project_dir/compose.yaml" run --rm lyra-sdk ./build.sh rootfs
        fi
        exec docker compose -f "$project_dir/compose.yaml" run --rm lyra-sdk ./build.sh "$action" "${@}"
        ;;
    shell)
        exec docker compose -f "$project_dir/compose.yaml" run --rm lyra-sdk bash
        ;;
    *)
        echo "Usage: $0 {image|download|download-cache|prepare|sync-sources|lunch|build|clean|flash|rootfs|kernel|uboot|firmware|buildroot-config|shell}" >&2
        exit 2
        ;;
esac
