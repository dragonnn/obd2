From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Local build
Date: Wed, 2 Sep 2026 00:00:00 +0000
Subject: [PATCH] adbd: use IPv4 for the non-Android smartsocket listener

The non-Android adbd build uses libcutils' socket_inaddr_any_server().
That helper was hard-coded to create an AF_INET6 socket, causing adbd to
abort with EAFNOSUPPORT when the target kernel is built without IPv6.

The smartsocket only needs a local TCP listener, so use IPv4 here.

Signed-off-by: Local build <builder@localhost>
---
 libcutils/socket_inaddr_any_server_unix.c | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/libcutils/socket_inaddr_any_server_unix.c b/libcutils/socket_inaddr_any_server_unix.c
--- a/libcutils/socket_inaddr_any_server_unix.c
+++ b/libcutils/socket_inaddr_any_server_unix.c
@@ -31,19 +31,19 @@
 /* open listen() port on any interface */
 int socket_inaddr_any_server(int port, int type)
 {
-    struct sockaddr_in6 addr;
+    struct sockaddr_in addr;
     int s, n;
 
     memset(&addr, 0, sizeof(addr));
-    addr.sin6_family = AF_INET6;
-    addr.sin6_port = htons(port);
-    addr.sin6_addr = in6addr_any;
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(port);
+    addr.sin_addr.s_addr = htonl(INADDR_ANY);
 
-    s = socket(AF_INET6, type, 0);
+    s = socket(AF_INET, type, 0);
     if (s < 0) return -1;
 
     n = 1;
     setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (const char *) &n, sizeof(n));
 
-    if (bind(s, (struct sockaddr *) &addr, sizeof(addr)) < 0) {
+    if (bind(s, (struct sockaddr *) &addr, sizeof(addr)) < 0) {
         close(s);
         return -1;
     }
