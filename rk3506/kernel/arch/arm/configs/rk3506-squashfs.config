CONFIG_MTD_UBI_BLOCK=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
# CONFIG_SQUASHFS_ZSTD is not set
# No sound card is present on this board.
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_SND_SOC is not set
# Keep the touchscreen subsystem for the planned CST3530 driver, but do not
# build or probe the currently unused controller drivers.
CONFIG_INPUT_TOUCHSCREEN=y
# CONFIG_KEYBOARD_ADC is not set
# CONFIG_TOUCHSCREEN_EDT_FT5X06 is not set
# CONFIG_TOUCHSCREEN_GOODIX is not set
# CONFIG_TOUCHSCREEN_GSLX680_PAD is not set
# CONFIG_TOUCHSCREEN_GT1X is not set
# The FIQ debugger and serial console are not used; ADB is the console path.
# CONFIG_FIQ_DEBUGGER is not set
# CONFIG_FIQ_DEBUGGER_NO_SLEEP is not set
# CONFIG_FIQ_DEBUGGER_CONSOLE is not set
# CONFIG_FIQ_DEBUGGER_CONSOLE_DEFAULT_ENABLE is not set
# CONFIG_FIQ_DEBUGGER_TRUST_ZONE is not set
# CONFIG_USB_CONFIGFS_ACM is not set
# Keep the USB gadget path built in; this image does not install kernel modules.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_DWC2=y
# USB ADB is the only USB gadget function needed.
# CONFIG_USB_CONFIGFS_RNDIS is not set

# USB ADB must work without udev/module auto-loading.
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y

# Unrelated Bluetooth transport.
# CONFIG_BT_INTEL is not set
# CONFIG_BT_HCIBTUSB is not set

# Unrelated Ethernet, PHY, and MDIO drivers.
# CONFIG_STMMAC_ETH is not set
# CONFIG_STMMAC_PLATFORM is not set
# CONFIG_DWMAC_ROCKCHIP is not set
# CONFIG_PHYLIB is not set
# CONFIG_PHYLINK is not set
# CONFIG_FIXED_PHY is not set
# CONFIG_MDIO_DEVRES is not set
# CONFIG_MDIO_DEVICE is not set
# CONFIG_MDIO_BUS is not set
# CONFIG_MII is not set
# CONFIG_MOTORCOMM_PHY is not set
# CONFIG_PCS_XPCS is not set
# CONFIG_AX88796B_PHY is not set

# Unrelated USB network, HID, serial, modem, storage, and SCSI support.
# CONFIG_USB_HID is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_USB_USBNET is not set
# CONFIG_USB_NET_AX8817X is not set
# CONFIG_USB_NET_AX88179_178A is not set
# CONFIG_USB_NET_CDCETHER is not set
# CONFIG_USB_NET_CDC_NCM is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_RNDIS_HOST is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_CDC_SUBSET_ENABLE is not set
# CONFIG_USB_NET_ZAURUS is not set
# CONFIG_USB_NET_QMI_WWAN is not set
# CONFIG_USB_RTL8153_ECM is not set
# CONFIG_USB_WDM is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_SCSI is not set
# CONFIG_SCSI_COMMON is not set
# CONFIG_SCSI_MOD is not set
# CONFIG_SCSI_LOWLEVEL is not set
