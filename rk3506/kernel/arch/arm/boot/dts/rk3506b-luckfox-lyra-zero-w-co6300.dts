/dts-v1/;

#include "rk3506-luckfox-lyra-co6300.dtsi"

/ {
	model = "Luckfox Lyra Zero W with CO6300 AMOLED";
	compatible = "rockchip,rk3506g-demo-display-control", "rockchip,rk3506";

	chosen {
		bootargs = "console=tty1 fbcon=font:10x18 fbcon=rotate:3 vt.global_cursor_default=0 root=/dev/mtdblock2 rootfstype=squashfs ro rootwait";
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		BT,power_gpio = <&gpio1 RK_PC5 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	vcc3v3_lcd: vcc3v3-lcd {
		status = "okay";
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_pwren_h>;
		regulator-name = "vcc3v3_lcd";
		regulator-always-on;
	};
};

/**********media**********/
&mmc {
	/* For SDMMC */
	max-frequency = <52000000>;
	bus-width = <4>;
	no-sdio;
	no-mmc;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	cd-gpios = <&gpio1 RK_PB6 GPIO_ACTIVE_LOW>; //det
	disable-wp;
	//sd-uhs-sdr104;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk_pins &sdmmc_cmd_pins &sdmmc_bus4_pins &sdmmc_det &sdmmc_pwren>;
	vqmmc-supply = <&vcc_3v3>;
	vmmc-supply = <&vcc_3v3>;
	status = "okay";
};

&fspi {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <80000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********display**********/
&cma {
	size = <0x2000000>;
};

&dsi {
	status = "okay";
};

&dsi_dphy {
	status = "okay";
};

&dsi_in_vop {
	status = "okay";
};

&route_dsi {
	status = "okay";
};

&dsi_panel {
	power-supply = <&vcc3v3_lcd>;
};

/**********ethernet**********/
&gmac1 {
	status = "disabled";
};

&rng {
	status = "okay";
};

/**********CAN**********/
/* Keep CAN RX on DMA1 so SPI1 and both UARTs fit DMA0's six channels. */
&can0 {
	assigned-clocks = <&cru CLK_CAN0>;
	assigned-clock-rates = <300000000>;
	dmas = <&dmac1 10 0xff288078 0x0c000400 0xff2880ac 0x03000000>;
	dma-names = "rx";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io27_can0_tx &rm_io28_can0_rx>;
	status = "okay";
};

&can1 {
	assigned-clocks = <&cru CLK_CAN1>;
	assigned-clock-rates = <300000000>;
	dmas = <&dmac1 11 0xff288078 0x30001000 0xff2880ac 0x0c000000>;
	dma-names = "rx";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io25_can1_tx &rm_io26_can1_rx>;
	status = "okay";
};

/**********UART**********/
&uart1 {
	/* PCB U1: TX pin 27 (GPIO1_B1), RX pin 26 (GPIO0_B1). */
	dma-names = "tx", "rx";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io24_uart1_tx &rm_io9_uart1_rx>;
	status = "okay";
};

&uart2 {
	/* PCB U1: TX pin 38 (GPIO0_C1), RX pin 36 (GPIO1_D1). */
	dma-names = "tx", "rx";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io17_uart2_tx &rm_io29_uart2_rx>;
	status = "okay";
};

/**********SPI**********/
&spi1 {
	/* PCB U1: CS1 pin 21, SCLK pin 23, MISO pin 22, MOSI pin 18. */
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io7_spi1_csn1 &rm_io8_spi1_clk
		     &rm_io11_spi1_miso &rm_io12_spi1_mosi>;
	status = "okay";

	spidev@1 {
		compatible = "rockchip,spidev";
		reg = <1>;
		spi-max-frequency = <10000000>;
	};
};

/**********usb**********/
&usb20_otg0 {
	dr_mode = "peripheral";
	status = "okay";
};

&usb20_otg1 {
	dr_mode = "host";
	status = "okay";
};

/**********pinctrl**********/
&pinctrl {
	lcd {
		lcd_pwren_h: lcd-pwren-h {
			rockchip,pins = <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
