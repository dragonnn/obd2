#!/bin/sh

case "$1" in
start)
	mkdir -p /mnt/sdcard
	if ! mount | grep -q ' on /mnt/sdcard '; then
		mount -t ext4 -o noatime,nodiratime LABEL=LYRA_SD /mnt/sdcard || {
			echo "Warning: unable to mount SD card (label LYRA_SD)" >&2
			exit 0
		}
	fi
	mkdir -p /mnt/sdcard/fish /mnt/sdcard/fish/completions
	chmod 700 /mnt/sdcard/fish
	;;
esac

exit 0
