digraph TelemetryFlow {
    graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.55, ranksep=0.7,
           fontname="DejaVu Sans", fontsize=20, fontcolor="#0f172a",
           label="Telemetry and bidirectional modem data flow", labelloc=t];
    node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
          fontsize=13, color="#94a3b8", fillcolor="#f8fafc",
          fontcolor="#0f172a", margin="0.22,0.16", penwidth=1.3];
    edge [fontname="DejaVu Sans", fontsize=11, color="#475569",
          fontcolor="#334155", arrowsize=0.8, penwidth=1.3];

    lyra_rx [label="Lyra UART\nPID data"];
    can [label="Local CAN\nPID data"];
    supervisor [label="Vehicle supervisor\nCurrent vehicle state", fillcolor="#dbeafe", color="#2563eb"];
    store [label="Telemetry store\nvalue | source | observation time | validity",
           fillcolor="#dbeafe", color="#2563eb"];
    display [label="E-ink task\nRate-limited refresh"];
    radio [label="IEEE 802.15.4 task", fillcolor="#ccfbf1", color="#0d9488"];
    modem [label="External modem", fillcolor="#ccfbf1", color="#0d9488"];
    router [label="Incoming information router"];
    queue [label="Bounded forwarding queue\nLatest values; command expiry"];
    uart_tx [label="UART TX service"];
    lyra [label="Lyra application", fillcolor="#f5f3ff", color="#8b5cf6"];

    {rank=same; lyra_rx; can; supervisor;}
    {rank=same; display; radio; modem;}

    lyra_rx -> store;
    can -> store;
    supervisor -> store;
    store -> display [label="Latest snapshot"];
    store -> radio [label="State + PID snapshot"];
    radio -> modem [dir=both, xlabel="Telemetry / incoming info",
                    tailport=e, headport=w];
    radio -> router [label="Incoming information"];
    router -> store [label="Update local information", constraint=false];
    router -> queue [label="Information for Lyra"];
    queue -> uart_tx [label="When application is ready"];
    uart_tx -> lyra;
}
