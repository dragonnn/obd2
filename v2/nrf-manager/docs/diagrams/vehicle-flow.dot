digraph VehicleFlow {
    graph [rankdir=TB, compound=true, bgcolor="white", pad=0.35,
           nodesep=0.55, ranksep=0.8, fontname="DejaVu Sans", fontsize=20,
           fontcolor="#0f172a", label="Vehicle supervisor: mode transitions",
           labelloc=t];
    node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
          fontsize=13, color="#94a3b8", fillcolor="white",
          fontcolor="#0f172a", margin="0.22,0.16", penwidth=1.3];
    edge [fontname="DejaVu Sans", fontsize=11, color="#475569",
          fontcolor="#334155", arrowsize=0.8, penwidth=1.3];

    init [label="Initialising", fillcolor="#f1f5f9"];

    subgraph cluster_driving {
        label="Driving";
        fontsize=16;
        style="rounded,filled";
        color="#93c5fd";
        fillcolor="#eff6ff";
        margin=24;
        stop_can [label="StopLocalCan\nStop local CAN polling"];
        managed [label="LyraManaged\nLyra controller maintains ON"];
        stop_can -> managed [label="CAN quiescent\nrequest Lyra ON"];
    }

    subgraph cluster_off {
        label="IgnitionOff";
        fontsize=16;
        style="rounded,filled";
        color="#86efac";
        fillcolor="#f0fdf4";
        margin=24;
        wait_off [label="WaitingForLyraOff\nRequest Lyra OFF"];
        observing [label="Observing\nOBC + open/closed checks"];
        charging [label="Charging\nOBC + BMS polling", fillcolor="#dcfce7"];
        sleep [label="ParkedSleep\nSparse probe windows"];

        wait_off -> observing [label="Lyra power cut\nconfirmed"];
        observing -> charging [label="OBC responds"];
        observing -> sleep [label="Observation\nwindow expires"];
        charging -> sleep [label="Confirmed loss\nof OBC or BMS"];
        sleep -> charging [label="OBC responds to\na periodic probe", constraint=false];
    }

    init -> stop_can [label="Ignition high"];
    init -> wait_off [label="Ignition low", constraint=false];
    managed -> wait_off [label="Ignition falls\n(from any Driving child)",
                        ltail=cluster_driving, lhead=cluster_off,
                        color="#2563eb", fontcolor="#1d4ed8", minlen=2];
    observing -> stop_can [label="Ignition rises\n(from any IgnitionOff child)",
                          ltail=cluster_off, lhead=cluster_driving,
                          color="#2563eb", fontcolor="#1d4ed8", constraint=false];
}
