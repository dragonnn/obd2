import { IconDisplay, IconSet } from "../icons.slint";
import { PowerMenu } from "power-menu.slint";

component MainMenuAction inherits Rectangle {
    in property <bool> settings-icon;
    in property <string> label;
    callback selected();
    private property <bool> highlight;

    background: transparent;

    Rectangle {
        y: 20px;
        width: parent.width;
        height: parent.height - 40px;
        background: touch.pressed || root.highlight ? #263139 : transparent;
        border-radius: 20px;
        animate background { duration: 90ms; easing: ease-in-out; }
    }

    IconDisplay {
        x: (parent.width - self.width) / 2;
        y: 55px;
        size: 110px;
        icon: root.settings-icon ? IconSet.Settings : IconSet.Power;
        stroke: #f2f4f3;
        stroke-width: 4;
        absolute-stroke-width: true;
    }

    Text {
        y: 175px;
        width: parent.width;
        height: 36px;
        text: root.label;
        color: #f2f4f3;
        font-size: 22px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Timer {
        interval: 360ms;
        running: root.highlight;
        triggered => {
            root.highlight = false;
            root.selected();
        }
    }

    touch := TouchArea {
        clicked => { root.highlight = true; }
    }
}

component MainMenu inherits Rectangle {
    callback power-selected();

    background: #000000;

    MainMenuAction {
        x: root.width / 4 - self.width / 2;
        width: 230px;
        height: root.height;
        settings-icon: true;
        label: "Settings";
    }

    MainMenuAction {
        x: root.width * 3 / 4 - self.width / 2;
        width: 230px;
        height: root.height;
        settings-icon: false;
        label: "Power";
        selected => { root.power-selected(); }
    }
}

export component MenuPage inherits Rectangle {
    in-out property <bool> power-menu-open: false;
    callback restart-requested();
    callback reboot-requested();
    callback shutdown-requested();

    background: #000000;

    menu-swipe := SwipeGestureHandler {
        handle-swipe-right: root.power-menu-open;

        swiped => {
            if self.current-position.x > self.pressed-position.x + self.width / 4 {
                root.power-menu-open = false;
            }
        }

        HorizontalLayout {
            property <length> resting-x: root.power-menu-open ? -root.width : 0px;
            property <length> swipe-offset;
            x: self.resting-x + self.swipe-offset;
            spacing: 0px;

            animate resting-x { duration: 200ms; easing: ease-in-out; }

            states [
                swiping when menu-swipe.swiping: {
                    swipe-offset: menu-swipe.current-position.x - menu-swipe.pressed-position.x;
                    out { animate swipe-offset { duration: 200ms; easing: ease-in-out; } }
                }
            ]

            MainMenu {
                width: root.width;
                height: root.height;
                power-selected => { root.power-menu-open = true; }
            }

            PowerMenu {
                width: root.width;
                height: root.height;
                restart-requested => { root.restart-requested(); }
                reboot-requested => { root.reboot-requested(); }
                shutdown-requested => { root.shutdown-requested(); }
            }
        }
    }
}
