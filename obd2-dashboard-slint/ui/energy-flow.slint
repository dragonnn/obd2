component ArrowShape inherits Path {
    in property <color> arrow-color;
    in property <bool> points-right;
    in property <length> notch-width: 18px;

    fill: root.arrow-color;

    MoveTo {
        x: root.points-right ? 0 : root.width / 1px;
        y: 0;
    }
    LineTo {
        x: root.points-right ? root.notch-width / 1px : (root.width - root.notch-width) / 1px;
        y: root.height / 2px;
    }
    LineTo {
        x: root.points-right ? 0 : root.width / 1px;
        y: root.height / 1px;
    }
    LineTo {
        x: root.points-right ? (root.width - root.notch-width) / 1px : root.notch-width / 1px;
        y: root.height / 1px;
    }
    LineTo {
        x: root.points-right ? root.width / 1px : 0;
        y: root.height / 2px;
    }
    LineTo {
        x: root.points-right ? (root.width - root.notch-width) / 1px : root.notch-width / 1px;
        y: 0;
    }
    Close { }
}

export component EnergyFlow inherits Rectangle {
    in property <float> power-kw: 18.6;
    in property <float> maximum-power-kw: 40;

    private property <float> absolute-power: abs(root.power-kw);
    private property <float> power-ratio: min(1, root.absolute-power / max(1, root.maximum-power-kw));
    private property <bool> discharging: root.power-kw >= 0;
    private property <length> arrow-notch-width: 18px;
    private property <length> arrow-gap: 15px;
    private property <color> flow-color: root.discharging ? #65d99b : #5bc8ff;
    private property <duration> cycle-duration: 1400ms - root.power-ratio * 800ms;
    private property <float> travel-progress: root.absolute-power < 0.05
        ? 0
        : Math.mod(animation-tick(), root.cycle-duration) / root.cycle-duration;

    background: transparent;

    VerticalLayout {
        spacing: 2px;

        Text {
            height: parent.height - 46px;
            text: "\{round(root.power-kw * 10) / 10} kW";
            color: white;
            font-size: 25px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            height: 44px;
            clip: true;
            background: root.flow-color.with-alpha(0.18);
            border-radius: 10px;

            // Three arrows keep an identical neighbor outside both clipped
            // edges. The small offset exposes the dim track as a clear
            // V-shaped separator between consecutive arrows.
            for _[index] in 3: ArrowShape {
                x: root.discharging
                    ? (index - 1 + root.travel-progress)
                        * (parent.width - root.arrow-notch-width + root.arrow-gap)
                    : (1 - index - root.travel-progress)
                        * (parent.width - root.arrow-notch-width + root.arrow-gap);
                width: parent.width;
                height: parent.height;
                arrow-color: root.flow-color;
                points-right: root.discharging;
                notch-width: root.arrow-notch-width;
                opacity: root.absolute-power < 0.05 ? 0 : 1;
            }
        }
    }
}
