component ArrowShape inherits Rectangle {
    in property <color> arrow-color;
    in property <bool> points-right;

    private property <length> tip-width: 18px;
    private property <length> tip-overlap: 10px;
    background: transparent;

    Rectangle {
        x: root.points-right ? 0 : min(parent.width, root.tip-width - root.tip-overlap);
        y: (parent.height - self.height) / 2;
        width: max(0px, parent.width - root.tip-width + root.tip-overlap);
        height: 30px;
        background: root.arrow-color;
        border-radius: 15px;
    }

    Path {
        x: root.points-right ? max(0px, parent.width - root.tip-width) : 0;
        y: (parent.height - self.height) / 2;
        width: min(parent.width, root.tip-width);
        height: 30px;
        commands: root.points-right
            ? "M 0 0 L 100 50 L 0 100 Z"
            : "M 100 0 L 0 50 L 100 100 Z";
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        fill: root.arrow-color;
    }
}

export component EnergyFlow inherits Rectangle {
    in property <float> power-kw: 18.6;
    in property <float> maximum-power-kw: 40;

    private property <float> absolute-power: abs(root.power-kw);
    private property <float> power-ratio: min(1, root.absolute-power / max(1, root.maximum-power-kw));
    private property <bool> discharging: root.power-kw >= 0;
    private property <color> flow-color: root.discharging ? #65d99b : #5bc8ff;
    private property <duration> cycle-duration: 1400ms - root.power-ratio * 800ms;
    private property <float> travel-progress: root.absolute-power < 0.05
        ? 0
        : Math.mod(animation-tick(), root.cycle-duration) / root.cycle-duration;

    background: transparent;

    VerticalLayout {
        spacing: 2px;

        Text {
            height: 38px;
            text: "\{round(root.power-kw * 10) / 10} kW";
            color: white;
            font-size: 25px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            clip: true;
            background: transparent;

            // A quiet track shows the full travel without leaving a fixed
            // arrowhead at the far edge.
            Rectangle {
                x: 5px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 10px;
                height: 30px;
                background: root.flow-color.with-alpha(0.18);
                border-radius: 8px;
            }

            // Two full arrows travel back-to-back. As one leaves the clipped
            // viewport, the next enters behind it, avoiding a reset jump.
            for _[index] in 2: ArrowShape {
                x: root.discharging
                    ? (index - 1 + root.travel-progress) * parent.width
                    : (1 - index - root.travel-progress) * parent.width;
                width: parent.width;
                height: parent.height;
                arrow-color: root.flow-color;
                points-right: root.discharging;
                opacity: root.absolute-power < 0.05 ? 0 : 1;
            }
        }
    }
}
