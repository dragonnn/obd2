export component FuelUsage inherits Rectangle {
    in property <float> consumption: 4.8;
    in property <float> maximum-consumption: 14;
    private property <float> scale-maximum: max(0.1, root.maximum-consumption);
    private property <float> display-value: round(max(0, root.consumption) * 10) / 10;
    private property <color> usage-color: root.consumption < 4 ? #075985
        : root.consumption < 6 ? #086b35 : #991b2b;
    background: transparent;

    Rectangle {
        x: 0px;
        y: 5px;
        width: parent.width;
        height: 40px;
        background: #111713;
        border-color: #718078;
        border-width: 2px;
        border-radius: 8px;
        clip: true;
        Rectangle {
            x: 4px;
            y: 4px;
            width: max(0px, parent.width * max(0, min(1, root.consumption / root.scale-maximum)) - 8px);
            height: max(0px, parent.height - 8px);
            border-radius: 6px;
            background: root.usage-color;
        }
        // Short edge marks indicate the thresholds without crossing the text.
        for tick in [4, 6]: Rectangle {
            visible: tick < root.scale-maximum;
            x: parent.width * tick / root.scale-maximum;
            y: parent.height - 8px;
            width: 1px;
            height: 8px;
            background: #9ba49e;
        }
        // Paint the outline over the fill, as in the traction battery.
        Rectangle {
            x: 0px; y: 0px;
            width: parent.width; height: parent.height;
            background: transparent;
            border-color: #718078;
            border-width: 2px;
            border-radius: 8px;
        }
    }

    // Paint the label last so it stays legible over both fill and empty track.
    HorizontalLayout {
        x: 7px;
        y: 8px;
        width: parent.width - 14px;
        height: 34px;
        spacing: 4px;
        alignment: center;
        Text {
            text: "\{floor(root.display-value)}.\{round((root.display-value - floor(root.display-value)) * 10)}";
            color: #ffffff;
            font-size: 24px;
            vertical-alignment: center;
        }
        Text {
            y: 1px;
            text: "L/100 km";
            color: #ffffff;
            font-size: 14px;
            vertical-alignment: center;
        }
    }

}
