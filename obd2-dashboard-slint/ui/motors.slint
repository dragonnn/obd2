component IceMotor inherits Rectangle {
    in property <bool> active;
    private property <color> active-color: #ffb454;
    private property <color> inactive-color: #435048;

    background: transparent;

    Path {
        x: (parent.width - self.width) / 2;
        y: 4px;
        width: 62px;
        height: 62px;
        commands: "M 5 10 L 12 10 L 12 4 L 27 4 L 34 11 L 47 11 L 47 21 L 53 21 L 53 16 L 59 16 L 59 49 L 53 49 L 53 43 L 47 43 L 47 53 L 35 53 L 28 60 L 13 60 L 13 55 L 5 55 Z";
        viewbox-width: 64;
        viewbox-height: 64;
        stroke: root.active ? root.active-color : root.inactive-color;
        stroke-width: 2.5px;
        stroke-line-join: round;
        fill: transparent;
    }

    // Vector recreation of the original fuel-pump status symbol.
    Path {
        x: (parent.width - self.width) / 2;
        y: 25px;
        width: 24px;
        height: 28px;
        commands: "M 3 25 L 3 7 Q 3 3 7 3 L 14 3 Q 17 3 17 7 L 17 25 Z M 6 7 L 14 7 L 14 13 L 6 13 Z M 17 8 C 22 8 22 12 22 15 L 22 22 Q 22 25 19 25 Q 17 25 17 22";
        viewbox-width: 25;
        viewbox-height: 28;
        stroke: root.active ? white : #29322d;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        opacity: root.active ? 1 : 0.72;
        animate opacity { duration: 180ms; }
    }

    Text {
        y: parent.height - 17px;
        width: parent.width;
        text: "ICE";
        color: root.active ? root.active-color : root.inactive-color;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        horizontal-alignment: center;
    }
}

component ElectricMotor inherits Rectangle {
    in property <bool> active;
    private property <color> active-color: #5bc8ff;
    private property <color> inactive-color: #435048;

    background: transparent;

    Path {
        x: (parent.width - self.width) / 2;
        y: 4px;
        width: 62px;
        height: 62px;
        commands: "M 57 4 L 57 11 L 44 11 L 37 18 L 20 18 L 20 23 L 15 18 L 7 18 Q 3 18 3 23 L 3 51 Q 3 56 7 56 L 15 56 L 20 51 L 20 56 L 37 56 L 44 49 L 57 49 L 57 56";
        viewbox-width: 64;
        viewbox-height: 64;
        stroke: root.active ? root.active-color : root.inactive-color;
        stroke-width: 2.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }

    // Scalable lightning symbol replacing the on/off bitmap layers.
    Path {
        x: (parent.width - self.width) / 2;
        y: 23px;
        width: 23px;
        height: 31px;
        commands: "M 13 1 L 3 17 L 10 17 L 7 30 L 21 11 L 14 11 L 18 1 Z";
        viewbox-width: 24;
        viewbox-height: 31;
        fill: root.active ? white : #29322d;
        opacity: root.active ? 1 : 0.72;
        animate opacity { duration: 180ms; }
    }

    Text {
        y: parent.height - 17px;
        width: parent.width;
        text: "EV";
        color: root.active ? root.active-color : root.inactive-color;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        horizontal-alignment: center;
    }
}

export component MotorsWidget inherits Rectangle {
    in property <bool> ice-on: false;
    in property <bool> electric-on: true;

    background: #111713;
    border-color: #718078;
    border-width: 2px;
    border-radius: 12px;
    clip: true;

    HorizontalLayout {
        padding: 5px;
        spacing: 5px;

        IceMotor {
            active: root.ice-on;
        }

        Rectangle {
            width: 1px;
            background: #71807880;
        }

        ElectricMotor {
            active: root.electric-on;
        }
    }
}
