component IceMotor inherits Rectangle {
    in property <bool> active;
    background: transparent;
    clip: true;

    // Centerlines measured from the committed 52 × 64 trace. Segments are
    // snapped to horizontal, vertical, and the source's technical diagonals.
    Path {
        width: parent.width;
        height: parent.height;
        commands: "M 5 0 L 20 0 L 20 6 L 7 6 L 7 11 L 20 11 L 25 20 L 37 20 L 37 53 L 28 53 L 19 62 L 5 62 M 43 20 L 50 20 L 50 37 L 47 38 L 47 53 L 43 53 L 43 20 M 37 34 L 43 34 M 37 40 L 43 40";
        viewbox-width: 52;
        viewbox-height: 64;
        stroke: root.active ? #ffb454 : #435048;
        stroke-width: 1.75px;
        stroke-line-cap: square;
        stroke-line-join: round;
        fill: transparent;
    }

    Path {
        x: parent.width * 5 / 52;
        y: parent.height * 24 / 64;
        width: parent.width * 22 / 52;
        height: parent.height * 25 / 64;
        commands: "M20 141 l0 -99 -6 -16 -6 -16 69 0 68 0 -3 45 -4 45 10 0 11 0 3 -37 3 -38 23 -3 22 -3 0 65 0 66 -10 0 -10 0 -2 -57 -1 -58 -4 39 -4 38 -19 5 -19 5 -3 57 -3 56 -57 3 -58 3 0 -100z m100 54 l0 -25 -45 0 -45 0 0 25 0 25 45 0 45 0 0 -25z M184 227 l6 -19 0 -19 0 -19 10 0 10 0 0 18 0 18 -16 20 -16 19 6 -18z";
        viewbox-width: 220;
        viewbox-height: 250;
        fill: root.active ? white : #27302b;
        transform-scale-y: -100%;
        opacity: root.active ? 1 : 0.8;
        animate opacity { duration: 180ms; }
    }
}

component ElectricMotor inherits Rectangle {
    in property <bool> active;
    background: transparent;
    clip: true;

    // Centerlines measured from the committed 59 × 64 trace.
    Path {
        width: parent.width;
        height: parent.height;
        commands: "M 39 0 L 54 0 M 39 0 L 39 6 L 51 6 L 51 11 L 38 11 L 31 18 L 18 18 L 18 52 L 30 62 L 50 62 L 50 57 M 13 20 L 3 20 L 0 24 L 0 53 L 3 56 L 13 56 L 13 52 M 13 48 L 13 20 M 13 24 L 18 24 M 13 52 L 18 52";
        viewbox-width: 59;
        viewbox-height: 64;
        stroke: root.active ? #5bc8ff : #435048;
        stroke-width: 1.75px;
        stroke-line-cap: square;
        stroke-line-join: round;
        fill: transparent;
    }

    Path {
        x: parent.width * 34 / 59;
        y: parent.height * 24 / 64;
        width: parent.width * 18 / 59;
        height: parent.height * 25 / 64;
        commands: "M28 170 l-26 -70 33 0 33 0 -14 -45 -13 -45 20 0 19 0 45 70 45 70 0 5 0 5 -30 0 -30 0 0 5 0 6 14 34 15 35 -42 0 -42 0 -27 -70z";
        viewbox-width: 180;
        viewbox-height: 250;
        fill: root.active ? white : #27302b;
        transform-scale-y: -100%;
        opacity: root.active ? 1 : 0.8;
        animate opacity { duration: 180ms; }
    }
}

export component MotorsWidget inherits Rectangle {
    in property <bool> ice-on: false;
    in property <bool> electric-on: true;

    private property <length> label-height: 13px;
    private property <length> drawing-height: min(root.height - root.label-height, root.width * 64 / 111);
    private property <length> electric-width: root.drawing-height * 59 / 64;
    private property <length> ice-width: root.drawing-height * 52 / 64;
    private property <length> drawing-width: root.electric-width + root.ice-width;
    private property <length> drawing-x: (root.width - root.drawing-width) / 2;
    private property <length> drawing-y: (root.height - root.label-height - root.drawing-height) / 2;

    background: transparent;
    clip: true;

    ElectricMotor {
        x: root.drawing-x;
        y: root.drawing-y;
        width: root.electric-width;
        height: root.drawing-height;
        active: root.electric-on;
    }

    Rectangle {
        x: root.drawing-x + root.electric-width - 1px;
        y: root.drawing-y;
        width: 2px;
        height: root.drawing-height;
        background: transparent;

        for _[index] in 6: Rectangle {
            y: index * parent.height / 6 + 2px;
            width: 2px;
            height: parent.height / 12;
            background: root.electric-on ? #5bc8ff : root.ice-on ? #ffb454 : #435048;
        }
    }

    IceMotor {
        x: root.drawing-x + root.electric-width;
        y: root.drawing-y;
        width: root.ice-width;
        height: root.drawing-height;
        active: root.ice-on;
    }

    Text {
        x: root.drawing-x;
        y: root.drawing-y + root.drawing-height;
        width: root.electric-width;
        height: root.label-height;
        text: "EV";
        color: root.electric-on ? #5bc8ff : #435048;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: root.drawing-x + root.electric-width;
        y: root.drawing-y + root.drawing-height;
        width: root.ice-width;
        height: root.label-height;
        text: "ICE";
        color: root.ice-on ? #ffb454 : #435048;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
