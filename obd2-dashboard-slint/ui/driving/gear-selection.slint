export component GearSelection inherits Rectangle {
    // mode selects P/R; D uses the numeric gear (1–6).
    in property <int> gear: 5;
    in property <string> mode: "D";
    background: transparent;
    clip: true;

    private property <float> position: root.mode == "P" ? 0
        : root.mode == "R" ? 1 : max(1, min(6, root.gear)) + 1;

    animate position {
        duration: 280ms;
        easing: ease-in-out;
    }

    // Keep all labels alive while moving them through the clipped viewport.
    // The same animated position drives movement, scale and highlighting.
    for label[index] in ["P", "R", "D1", "D2", "D3", "D4", "D5", "D6"]: Text {
        private property <float> distance: index - root.position;
        private property <float> separation: abs(self.distance);
        private property <float> emphasis: max(0, 1 - self.separation);
        private property <length> offset: (self.distance < 0 ? -1 : 1)
            * (min(1, self.separation) * 38px + max(0, self.separation - 1) * 21px);
        x: root.width / 2 + self.offset - self.width / 2;
        y: 0px;
        width: 48px;
        height: root.height;
        text: label;
        color: #f4f5f5.mix(#858b88, self.emphasis);
        font-size: 12px + max(0, 2 - self.separation) * 4px + self.emphasis * 16px;
        font-weight: round(400 + self.emphasis * 300);
        opacity: max(0, min(1, 3 - self.separation));
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
