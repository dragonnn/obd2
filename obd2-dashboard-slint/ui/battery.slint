component Metric inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    spacing: 0px;
    horizontal-stretch: 1;

    Text {
        text: root.value;
        color: white;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: bottom;
    }

    Text {
        text: root.label;
        color: #dbe7df;
        font-size: 8px;
        letter-spacing: 0.5px;
        vertical-alignment: top;
    }
}

export component BatteryWidget inherits Rectangle {
    in property <float> state-of-charge: 76;
    in property <float> pack-voltage: 357.2;
    in property <float> average-cell-voltage: 3.82;
    in property <float> cell-voltage-deviation: 20;
    in property <float> minimum-temperature: 18;
    in property <float> maximum-temperature: 24;

    private property <float> clamped-state-of-charge:
        root.state-of-charge < 0 ? 0 : root.state-of-charge > 100 ? 100 : root.state-of-charge;
    private property <color> fill-color: root.clamped-state-of-charge <= 10
        ? #dc1f11
        : root.clamped-state-of-charge <= 20 ? #e29015 : #03c451;

    // Battery terminal. It sits behind the body so its left border is hidden
    // and it reads as a single outline protruding from the right side.
    Rectangle {
        x: root.width - 24px;
        y: (root.height - self.height) / 2;
        width: 24px;
        height: 47px;
        background: #111713;
        border-color: #718078;
        border-width: 2px;
        border-radius: 8px;
    }

    Rectangle {
        width: root.width - 21px;
        height: root.height;
        background: #111713;
        border-color: #718078;
        border-width: 2px;
        border-radius: 12px;
        clip: true;

        // SOC is represented by the background of the entire widget, just as in
        // the original embedded dashboard. All values remain visible above it.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.clamped-state-of-charge / 100;
            height: parent.height;
            // Keep the fill's leading corners rounded explicitly. Some
            // software-renderer paths do not apply a rounded parent's clip
            // to child rectangles.
            border-radius: 12px;
            background: root.fill-color;
        }

        HorizontalLayout {
            padding: 7px;
            spacing: 7px;

            Text {
                width: 55px;
                text: "\{round(root.state-of-charge)}%";
                color: white;
                font-size: 27px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                width: 1px;
                background: #ffffff50;
            }

            VerticalLayout {
                spacing: 3px;

                HorizontalLayout {
                    spacing: 8px;

                    Metric {
                        value: "\{round(root.pack-voltage * 10) / 10} V";
                        label: "PACK";
                    }
                    Metric {
                        value: "\{round(root.average-cell-voltage * 100) / 100} V";
                        label: "AVG CELL";
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Metric {
                        value: "\{round(root.minimum-temperature)}–\{round(root.maximum-temperature)} °C";
                        label: "TEMP RANGE";
                    }
                    Metric {
                        value: "Δ \{round(root.cell-voltage-deviation)} mV";
                        label: "CELL SPREAD";
                    }
                }
            }
        }

        // Paint the outline last so the runtime software renderer cannot let
        // the SOC fill cover the rounded left edge.
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;
            border-color: #718078;
            border-width: 2px;
            border-radius: 12px;
        }
    }
}
